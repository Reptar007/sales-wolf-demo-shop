# WolfMart demo shop — environment
# NOTE: this app must NEVER be given SalesWolf config vars.
# No SALESFORCE_*, NOTION_*, LINEAR_*, GOOGLE_*, or SalesWolf DATABASE_URL/JWT_SECRET.
# The CI isolation guard fails the build if those names appear in this repo.

PORT=7072
NODE_ENV=development

# This app's OWN Postgres. Never SalesWolf's.
DATABASE_URL=postgresql://localhost:5432/wolfmart_local

# Integration tests TRUNCATE this database. Never point it at real data.
TEST_DATABASE_URL=postgresql://localhost:5432/wolfmart_test

# This app's OWN signing secret. Never SalesWolf's JWT_SECRET value.
DEMO_JWT_SECRET=

# Passphrase gating the SE-only screens: /demo-control and the /agent chat console.
DEMO_CONTROL_PASSPHRASE=

# Shared with SalesWolf for now — see docs §8 carve-out. Swapping to a
# dedicated key with its own spend cap is a config change, no code change.
ANTHROPIC_API_KEY=

# AI assistant (optional). Unset ANTHROPIC_API_KEY and the assistant shows as
# offline; nothing else breaks. The route disables itself once this month's
# spend reaches the budget.
ASSISTANT_MONTHLY_BUDGET_USD=25
# ASSISTANT_MODEL=claude-opus-5
