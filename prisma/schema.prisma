// WolfMart demo shop — its OWN database. Never SalesWolf's.
// NOT WIRED UP YET. P0 opens no database connection, and @prisma/client is not
// a dependency -- its postinstall hangs on engine download, which stalled CI and
// would stall the Heroku build too. This file records the intended shape only.
//
// P1 reinstates Prisma with the catalog and commerce models, restores the
// Procfile release phase, and debugs the engine download with real models to
// generate. Do not add @prisma/client back without checking that first.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A deliberate bug an SE can switch on live. See docs §6.4.
model ChaosFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String
  /// What QA Wolf catches when this is on — doubles as demo script copy.
  proves      String
  enabled     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
